#!/usr/bin/env python3
"""Linux stand-in for lipo: -info, -archs, FILE -verify_arch ARCH..., -thin|-extract ARCH -output OUT."""
import struct, sys
CPU = {0x0100000c: "arm64", 0x01000007: "x86_64", 12: "armv7", 7: "i386", 0x0200000c: "arm64_32"}
def parse(p):
    with open(p, "rb") as f:
        d = f.read()
    m = struct.unpack(">I", d[:4])[0]
    if m in (0xcafebabe, 0xcafebabf):
        n = struct.unpack(">I", d[4:8])[0]
        out = []
        w = 20 if m == 0xcafebabe else 32
        for i in range(n):
            e = d[8 + i * w: 8 + (i + 1) * w]
            if m == 0xcafebabe:
                ct, st, off, size, al = struct.unpack(">IIIII", e)
            else:
                ct, st, off, size, al, _ = struct.unpack(">IIQQII", e)
            out.append((CPU.get(ct, hex(ct)), d[off:off + size], ct, st, al))
        return True, out
    # A thin Mach-O is little-endian for arm64 and x86_64: its magic reads as feedfacf
    # (64-bit) or feedface (32-bit) only when read little-endian, like the CPU type after it.
    ct = struct.unpack("<I", d[4:8])[0] if struct.unpack("<I", d[:4])[0] in (0xfeedfacf, 0xfeedface) else None
    if ct is None and d[:8] == b"!<arch>\n":
        return False, [("arm64", d, 0x0100000c, 0, 0)]  # thin static archive: assume the target arch
    return False, [(CPU.get(ct, hex(ct or 0)), d, ct, 0, 0)]
a = sys.argv[1:]
out = None
if "-output" in a:
    i = a.index("-output"); out = a[i + 1]; del a[i:i + 2]
if "-verify_arch" in a:  # lipo FILE -verify_arch ARCH...: exit 0 if FILE has all of them
    i = a.index("-verify_arch")
    if i != 1: sys.exit("lipo shim: usage: lipo FILE -verify_arch ARCH...")
    fat, sl = parse(a[0])
    sys.exit(0 if all(x in [s[0] for s in sl] for x in a[i + 1:]) else 1)
if a[0] in ("-info", "-archs"):
    op = a.pop(0)
    for f in a:
        fat, sl = parse(f)
        archs = " ".join(s[0] for s in sl)
        if op == "-archs": print(archs)
        elif fat: print("Architectures in the fat file: %s are: %s" % (f, archs))
        else: print("Non-fat file: %s is architecture: %s" % (f, archs))
    sys.exit(0)
if a[0] in ("-thin", "-extract"):
    arch, f = a[1], a[2]
    fat, sl = parse(f)
    s = [x for x in sl if x[0] == arch]
    if not s: sys.exit("lipo: %s has no %s" % (f, arch))
    open(out, "wb").write(s[0][1]); sys.exit(0)
sys.exit("lipo shim: unsupported " + " ".join(sys.argv[1:]))
