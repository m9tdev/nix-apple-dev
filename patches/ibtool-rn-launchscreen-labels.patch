+def _add_multiplier(b, o, el):
+    """nix-apple-dev: NSLayoutConstraint's NSMultiplier for multiplier="1/3" or
+    "0.5" (React Native's template LaunchScreen). Written only when it is not 1,
+    so the goldens are unchanged; its place among the keys is unverified."""
+    m = el.get("multiplier")
+    if m is None:
+        return
+    num, _, den = m.partition("/")
+    value = float(num) / float(den) if den else float(num)
+    if value != 1.0:
+        o.add("NSMultiplier", *b.float64(value))
